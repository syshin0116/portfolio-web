# Auth.js / NextAuth v5
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Production must contain at least one comma-separated, verified provider email.
AUTH_ALLOWED_EMAILS=
# Optional subset allowed to mutate shared assistants/models. Empty denies all.
AUTH_ADMIN_EMAILS=

# Shared with agent/.env. Generate with: openssl rand -hex 32
AGENT_AUTH_SECRET=

# Anonymous token bootstrap stays closed unless this is exactly "true".
AGENT_ANONYMOUS_TOKEN_ENABLED=false
# Vercel-only cookie key. Generate independently with: openssl rand -hex 32
ANONYMOUS_SESSION_SECRET=
# Public UI gate. Enable only after the agent public-wire and spend/retention
# gates are deployed and verified. Vercel BotID Basic protects token bootstrap.
NEXT_PUBLIC_AGENT_ANONYMOUS_ENABLED=false

# Auth.js runtime: branch-scoped, least-privileged direct Postgres endpoint.
# Keep exactly one sslmode=require query pair; strip Neon-generated channel_binding.
# Every other query key, fragment, -pooler endpoint, and non-empty PG* var fails.
DATABASE_URL=
# Migration/verification only; same URL contract. Never expose it to Vercel.
# sslmode=disable is accepted only by the explicit CI-test CLI path, never runtime.
AUTH_DATABASE_MIGRATION_URL=

# OAuth providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Agent backend origin (no path, credentials, query, or fragment).
# Production: HTTPS. Localhost/127.0.0.1/[::1]: HTTP or HTTPS.
NEXT_PUBLIC_AGENT_API_URL=
NEXT_PUBLIC_AGENT_ASSISTANT_ID=agent
