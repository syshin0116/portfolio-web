# The evaluation publication image receives only reviewed Dockerfile inputs.
**

# Root workspace resolution.
!pyproject.toml
!uv.lock

# Agent runtime and retrieval policies.
!agent/
agent/**
!agent/pyproject.toml
!agent/src/
!agent/src/**
!agent/corpus-policy.toml
!agent/bm25-policy.toml

# Evaluation runtime and committed query sets.
!eval/
eval/**
!eval/pyproject.toml
!eval/src/
!eval/src/**
!eval/querysets/
!eval/querysets/**

# Reproducible index builder and immutable corpus.
!scripts/
scripts/**
!scripts/build_index.py
!content/
!content/**

# Generated build and test output inside allowed trees stays local.
**/Dockerfile*
**/.dockerignore
**/*.dockerignore
**/.git
**/.git/**
**/.venv
**/.venv/**
**/.index
**/.index/**
**/.pytest_cache
**/.pytest_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/__pycache__
**/__pycache__/**
**/*.py[cod]
eval/results
eval/results/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/coverage
**/coverage/**
**/.coverage
**/htmlcov
**/htmlcov/**

# Sensitive rules are terminal so broad source/corpus exceptions cannot reopen them.
**/.env
**/.env.*
**/.envrc
**/.npmrc
**/.pypirc
**/.netrc
**/.git-credentials
**/artifacts
**/artifacts/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.ppk
**/*.crt
**/*.cer
**/*.der
**/*.jks
**/*.keystore
**/*credentials*.json
**/*service-account*.json
**/*service_account*.json
**/application_default_credentials.json
**/*.tfstate*
**/*.tfvars
**/*.tfvars.*
**/.terraform
**/.terraform/**
**/.aws
**/.aws/**
**/.config/gcloud
**/.config/gcloud/**
**/.ssh
**/.ssh/**
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/ssh_host_*_key
**/.docker/config.json
**/.kube/config
