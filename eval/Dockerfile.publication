FROM ghcr.io/astral-sh/uv:0.12.3@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc AS uv

FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

COPY --from=uv /uv /uvx /bin/

WORKDIR /workspace
ENV PATH="/workspace/.venv/bin:${PATH}" \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
COPY agent/pyproject.toml agent/pyproject.toml
COPY eval/pyproject.toml eval/pyproject.toml
COPY agent/src agent/src
COPY eval/src eval/src
COPY agent/corpus-policy.toml agent/bm25-policy.toml agent/
COPY scripts/build_index.py scripts/build_index.py
COPY content content
COPY eval/querysets eval/querysets

ARG EVAL_DENSE=0
RUN uv sync --frozen --package syshin0116-dev-agent --all-extras --dev \
    && case "$EVAL_DENSE" in \
        0) uv sync --frozen --package syshin0116-dev-eval --all-groups ;; \
        1) uv sync --frozen --package syshin0116-dev-eval --extra dense --all-groups ;; \
        *) echo "EVAL_DENSE must be 0 or 1" >&2; exit 1 ;; \
    esac

CMD ["blogeval", "--help"]
