DATABASE_URL=
FF_V2_EVENT_STREAMING=true
RUN_MIGRATIONS_ON_STARTUP=false
ENV_MODE=LOCAL
REDIS_BROKER_ENABLED=false
BG_JOB_MAX_RETRIES=0

# Shared with web/.env.local. Generate with: openssl rand -hex 32
AGENT_AUTH_SECRET=

MODEL=
ANTHROPIC_API_KEY=

# Owner/eval capability lab only. Public/anonymous runtimes remain denied.
QUICKJS_ENABLED=false

# Independent public-agent gate. Keep false until the guest guard, model, and
# durable daily spend ledger are deployed together.
AGENT_ANONYMOUS_ACCESS_ENABLED=false
GUEST_MODEL=

# LangSmith (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
