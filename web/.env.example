# Auth.js / NextAuth v5
AUTH_SECRET=
AUTH_ALLOWED_EMAILS=
# Optional subset allowed to mutate shared assistants/models. Empty denies all.
AUTH_ADMIN_EMAILS=

# Shared with agent/.env. Generate with: openssl rand -hex 32
AGENT_AUTH_SECRET=

# Postgres (Neon, Supabase, etc.)
DATABASE_URL=

# OAuth providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Agent backend URL (LangGraph)
NEXT_PUBLIC_AGENT_API_URL=
