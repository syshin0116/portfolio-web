DATABASE_URL=
FF_V2_EVENT_STREAMING=true
RUN_MIGRATIONS_ON_STARTUP=false
ENV_MODE=LOCAL
REDIS_BROKER_ENABLED=false
BG_JOB_MAX_RETRIES=0

# Shared with web/.env.local. Generate with: openssl rand -hex 32
AGENT_AUTH_SECRET=

MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=

# Owner/eval capability lab only. Public/anonymous runtimes remain denied.
QUICKJS_ENABLED=false

# Independent public-agent gate. Keep false until the guest guard, exact OpenAI
# model, provider key, and durable daily spend ledger are deployed together.
AGENT_ANONYMOUS_ACCESS_ENABLED=false
# The reviewed production guest model is pinned exactly; this local example
# still keeps the public gate off until both budget values are supplied.
GUEST_MODEL=openai:gpt-5.6-luna
# Exact integer micro-dollar ceilings reviewed for GUEST_MODEL and the guest
# RunBudget policy. The computed floor is >=47892: the 15,892 µUSD worst
# generation allocation plus the separate 128k count-risk ledger at the
# cache-write rate. Production keeps the reviewed exact 47892 µUSD value.
# This is conservative accounting, not a provider hard cap.
# Both are required before the public-agent gate can turn on.
GUEST_DAILY_BUDGET_MICRO_USD=
GUEST_RUN_RESERVATION_MICRO_USD=

# LangSmith (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
